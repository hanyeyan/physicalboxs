#!name=OKOK 去广告
#!desc=移除开屏广告、应用内横幅/弹窗广告，拦截优惠购界面和发现页推荐流。含分组开关：开屏广告/应用内广告位/发现页/优惠购/广告追踪上报。适用 Loon 3.5.2 / OKOK iOS 3.7.x
# 参考链接: https://kelee.one/Tool/Loon/Lpx/OKOK_remove_ads.lpx
#!author=可莉🅥[https://github.com/luestr/ProxyResource] 修改增强
#!tag=去广告
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/OKOK.png
#!loon_version=3.5.2
#!date=2026-11-25 10:00:00

[Argument]
okok_splash = switch,true,false,tag=开屏广告,desc=拦截开屏广告拉取、素材图下载、竞价与配置下发
okok_banner = switch,true,false,tag=应用内广告位,desc=首页轮播图、卡路里卡片小广告、我的页 banner/float/popUp
okok_discover = switch,true,false,tag=发现页,desc=拦截发现页(广场)推荐内容流
okok_youzan = switch,true,false,tag=优惠购,desc=拦截商品列表与有赞店铺页面
okok_track = switch,true,false,tag=广告追踪上报,desc=拦截曝光/点击监测与行为日志上报

[Rewrite]
# ============ 开屏广告 (okok_splash) ============
# OKOK 自带广告 SDK 的开屏广告拉取接口（加密协议）
^https?:\/\/fdl\.zztfly\.com\/suba\/list reject enable={okok_splash}
# 开屏广告素材图下载（SDK 缓存广告计划的素材，美团云存储）
^https?:\/\/s3plus\.meituan\.net\/v1\/mss_5017c592a8a946d2a54eb62a76ba299c\/nebulafile\/ reject enable={okok_splash}
# 芯海自建 CPC 广告服务（第二套广告 SDK，下发京东等互动开屏广告配置，双域名镜像）
^https?:\/\/cpc-service-square\.(yunxish\.com|iggrowth\.cn)\/ reject enable={okok_splash}
# 开屏广告第三方竞价与追踪
^https?:\/\/l\.xiawan8\.com\/ reject enable={okok_splash}
^https?:\/\/lftxali\.xiawan8\.com\/ reject enable={okok_splash}
# 咪咕广告曝光上报
^https?:\/\/ggica\.miguvideo\.com\/ad\/ reject enable={okok_splash}
# 穿山甲(Pangle) 广告 SDK 可玩广告配置
^https?:\/\/lf-cdn-tos\.bytescm\.com\/obj\/static\/ad\/ reject enable={okok_splash}

# ============ 应用内广告位 (okok_banner) ============
# 首页轮播图、卡路里卡片小广告、我的页 banner/float/popUp、发现页 squareRecommend 推荐 banner
^https:\/\/api\.chips-cloud\.com\/v\d\/home\/collection\/smartv\d\? reject-dict enable={okok_banner}

# ============ 发现页 (okok_discover) ============
# 发现页(广场)社区推荐内容流，拦截后页面无推荐内容
^https:\/\/api\.chips-cloud\.com\/v\d\/communityManage\/list\? reject-dict enable={okok_discover}

# ============ 优惠购 (okok_youzan) ============
# 优惠购商品列表
^https:\/\/api\.chips-cloud\.com\/v\d\/good\/list\? reject-dict enable={okok_youzan}
# 优惠购有赞店铺页面
^https:\/\/shop171777386\.m\.youzan\.com\/ reject enable={okok_youzan}

# ============ 广告追踪上报 (okok_track) ============
# 广告曝光/点击监测
^https?:\/\/track\.vol\.ad-link\.cn\/ reject enable={okok_track}
# 广告 SDK 行为日志上报
^https?:\/\/(logrcv|tracelog-debug)\.yunxish\.com\/ reject enable={okok_track}
^https?:\/\/usr-api\.yunxish\.com\/report\/ reject enable={okok_track}

[MitM]
hostname=api.chips-cloud.com, shop171777386.m.youzan.com, lf-cdn-tos.bytescm.com, s3plus.meituan.net, cpc-service-square.yunxish.com, cpc-service-square.iggrowth.cn, track.vol.ad-link.cn, logrcv.yunxish.com, tracelog-debug.yunxish.com, usr-api.yunxish.com
